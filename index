<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Cozy Room</title>
  <!-- Google Fontsで可愛いフォントを読み込み -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;700&display=swap" rel="stylesheet">
  <!-- CSSファイルの読み込み -->
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- お部屋の壁紙エリア -->
  <main class="room">
    <!-- 中央の時計ガジェット -->
    <div class="clock-gadget">
      <div id="clock-time" class="time">00:00:00</div>
      <div id="clock-date" class="date">YYYY.MM.DD</div>
    </div>

    <!-- 右下の雨音コントロールボタン -->
    <div class="audio-control">
      <button id="rain-btn" class="rain-button">
        <span class="icon">🌧️</span>
        <span id="btn-text">雨の音を流す</span>
      </button>
    </div>
  </main>

  <!-- JavaScriptファイルの読み込み -->
  <script src="script.js"></script>
</body>
</html>
